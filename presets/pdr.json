    },
    {
      "if": { "dent_class": "stretched" },
      "action": "no_price",
      "message": "Сильное растяжение металла: цену мастер назовёт после осмотра."
    },
    {
      "if": { "dent_class": "strip", "size": "gt20" },
      "action": "no_price",
      "message": "Длинную вмятину считаем только после осмотра."
    },
    {
      "if": { "count": "many" },
      "action": "no_price",
      "message": "После града считаем пакетом — мастер свяжется и назовёт цену за всю машину."
    }
  ],
  "copy": {
